rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsDocument() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function ownsConversation(conversationId) {
      return signedIn()
        && get(/databases/$(database)/documents/conversations/$(conversationId)).data.userId == request.auth.uid;
    }

    function ownsTask(taskId) {
      return signedIn()
        && get(/databases/$(database)/documents/tasks/$(taskId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    // Workspace writes go through the authenticated Vercel API. This keeps
    // ownership, Space relationships and optimistic page revisions enforceable.
    match /spaces/{id} {
      allow read: if ownsDocument();
      allow write: if false;
    }
    match /dots/{id} {
      allow read: if ownsDocument();
      allow write: if false;
    }
    match /pages/{id} {
      allow read: if ownsDocument();
      allow write: if false;
    }
    match /memories/{id} {
      allow read: if ownsDocument();
      allow write: if false;
    }
    match /conversations/{conversationId} {
      allow read: if ownsDocument();
      allow write: if false;
      match /messages/{messageId} {
        allow read: if ownsConversation(conversationId);
        allow write: if false;
      }
    }

    // Only the API and trusted workers may claim jobs or append their audit
    // records. Browser/mobile users cannot forge a lease or a completed result.
    match /tasks/{taskId} {
      allow read: if ownsDocument();
      allow write: if false;
      match /runs/{runId} {
        allow read: if ownsTask(taskId);
        allow write: if false;
      }
      match /events/{eventId} {
        allow read: if ownsTask(taskId);
        allow write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
