# Render worker environment variables (same for render-1 and render-2)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=your-service-account-email@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Vercel API URL (e.g. https://your-app.vercel.app)
VERCEL_API_URL=https://your-vercel-app.vercel.app

# Required owner token (must match Vercel's worker authentication)
OWNER_TOKEN=your-24-plus-character-secret-token

# Idle queue polling; default 30 seconds. Both workers share the Firestore quota.
WORKER_POLL_INTERVAL_MS=30000

# Optional self-ping every 10 minutes (set this service's own URL in Render)
# Self-ping cannot recover a stopped process or guarantee free-tier availability.
SELF_URL=https://your-worker-service.onrender.com
