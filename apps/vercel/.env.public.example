# Firebase web app configuration (Firebase console -> Project settings -> Your apps -> Web app).
# These NEXT_PUBLIC_* values are the public web config: they identify (not authorize) your
# Firebase project for the client SDK and are safe to expose in browser bundles.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
